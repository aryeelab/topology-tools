params {
    // Required — no defaults; set via command line or submit script
    sample_id         = null
    bwa_index         = null   // path to BWA index .tgz
    chrom_sizes       = null   // path to .chrom.sizes file
    fq_input          = null   // glob pattern for input FASTQs, e.g. "/data/{sample}/*R{1,2}*.fastq.gz"
    outdir            = null   // output directory (must be on shared filesystem)
    tmpdir            = null   // temp directory for pairtools sort/merge (must be on shared filesystem)

    // Optional
    bwa_prefix        = ''
    failed_nodes_file = null   // path to per-sample node blacklist; enables bad-node exclusion
}

process {
    errorStrategy = 'retry'
    maxRetries = 3
    clusterOptions = {
        if (!params.failed_nodes_file) return ""
        def nodeFile = new File(params.failed_nodes_file.toString())
        if (!nodeFile.exists()) return ""
        def nodes = nodeFile.readLines().collect{it.trim()}.findAll{it}.unique().join(',')
        return nodes ? "--exclude=${nodes}" : ""
    }
    withName:microc_align {
        memory = '10 GB'
        cpus = 6
    }
    withName:mergepairs {
        memory = '100 GB'
        cpus = 8
    }
}

// Prepend the microc conda env bin dir to PATH for all Slurm child jobs.
// The submit script detects the env and exports MICROC_ENV before running Nextflow.
env {
    PATH = System.getenv('MICROC_ENV') ? "${System.getenv('MICROC_ENV')}/bin:${System.getenv('PATH')}" : System.getenv('PATH')
}

process {
    executor = 'slurm'
}
