manifest {
    name    = 'microc-preprocess'
    version = '1.1.1'
}

params {
    // Required — no defaults; set via command line or submit script
    sample_id         = null
    bwa_index         = null   // path to BWA index .tgz
    chrom_sizes       = null   // path to .chrom.sizes file
    fq_input          = null   // glob pattern for input FASTQs, e.g. "/data/{sample}/*R{1,2}*.fastq.gz"
    outdir            = null   // output directory (must be on shared filesystem)
    tmpdir            = null   // temp directory for pairtools sort/merge (must be on shared filesystem)

    // Optional
    bwa_prefix        = ''
    bamdir            = null   // BAM output directory; defaults to outdir if null
    pairsdir          = null   // pairs output directory; defaults to outdir if null
    statsdir          = null   // pairtools dedup stats output directory; defaults to outdir if null
    mapq              = 30     // pairtools parse --min-mapq
    aligner           = 'bwa-mem2' // bwa-mem2 | bwa (bwa: as up to 1.0.3)
    dedup_backend     = 'scipy'    // pairtools dedup --backend (cython: faster on pairsam, slower on light pairs, not transitive)
    chunk_reads       = 30000000 // reads per FASTQ chunk for parallel alignment
    dataset_dir       = null   // dataset dir (<DS>); if set, a FOCI-3D batch manifest row is written
    assay             = 'microc' // microc | rcmc (manifest column)
    git_commit        = null   // set by the submit script
    failed_nodes_file = null   // path to per-sample node blacklist; enables bad-node exclusion
}

process {
    errorStrategy = 'retry'
    maxRetries = 3
    clusterOptions = {
        if (!params.failed_nodes_file) return ""
        def nodeFile = new File(params.failed_nodes_file.toString())
        if (!nodeFile.exists()) return ""
        def nodes = nodeFile.readLines().collect{it.trim()}.findAll{it}.unique().join(',')
        return nodes ? "--exclude=${nodes}" : ""
    }
    withName:split_fastq {
        memory = '16 GB'
        cpus = 4
    }
    withName:microc_align {
        memory = '28 GB'   // bwa-mem2 holds ~19 GB for a human index (bwa: ~7 GB); samtools sort ~3 GB
        cpus = 6
    }
    withName:mergepairs {
        memory = '64 GB'   // samtools view -N holds the shorter of the kept / duplicate read-ID lists (~75 B per Illumina name)
        cpus = 8
    }
}

// Prepend the microc conda env bin dir to PATH for all Slurm child jobs.
// The submit script detects the env and exports MICROC_ENV before running Nextflow.
env {
    PATH = System.getenv('MICROC_ENV') ? "${System.getenv('MICROC_ENV')}/bin:${System.getenv('PATH')}" : System.getenv('PATH')
}

process {
    executor = 'slurm'
}
