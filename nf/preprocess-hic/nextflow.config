manifest {
    name    = 'preprocess-hic'
    version = '1.0.0'
}

params {
    // Required — set by preprocess-hic-submit.sh
    sample_id         = null
    bwa_index         = null   // indexed FASTA (prefix of .bwt etc.), or a .tar.gz of the index
    chrom_sizes       = null   // chromosome sizes of the same genome (sets pairs header, sort and cooler order)
    fq_input          = null   // fromFilePairs glob over all runs of the sample, e.g. "/fq/{SRR1,SRR2}_{1,2}.fastq.gz"
    outdir            = null   // run dir (shared filesystem): provenance, versions; outputs unless the *dir params are set
    tmpdir            = null   // temp dir for pairtools sort/merge (shared filesystem)
    genome_fasta      = null   // FASTA for the in-silico digest (usually the bwa index FASTA)
    frag_bed          = null   // precomputed restriction fragments BED; overrides genome_fasta + enzymes

    // Recipe
    aligner           = 'bwa-mem2' // bwa-mem2 | bwa (same alignments)
    min_mapq          = 1      // pairtools parse --min-mapq
    add_columns       = 'mapq,pos5,pos3,dist_to_5,dist_to_3,read_len'
    dedup_backend     = 'scipy'
    enzymes           = 'DpnII,HinfI' // Arima Hi-C+
    mcool_min_mapq    = 30     // MAPQ filter (both sides) for the pairs binned into the .mcool
    mcool_resolutions = '1000,2000,5000,10000,25000,50000,100000,250000,500000,1000000,2500000,5000000,10000000' // first = base
    assembly          = null   // cooler --assembly label, e.g. mm10
    chunk_reads       = 30000000

    // Optional output dirs (default: outdir)
    bamdir            = null
    pairsdir          = null
    statsdir          = null
    coolsdir          = null

    git_commit        = null   // set by the submit script
    failed_nodes_file = null   // per-sample node blacklist; enables bad-node exclusion
}

process {
    executor = 'slurm'
    errorStrategy = 'retry'
    maxRetries = 3
    clusterOptions = {
        if (!params.failed_nodes_file) return ""
        def nodeFile = new File(params.failed_nodes_file.toString())
        if (!nodeFile.exists()) return ""
        def nodes = nodeFile.readLines().collect{it.trim()}.findAll{it}.unique().join(',')
        return nodes ? "--exclude=${nodes}" : ""
    }
    withName:split_fastq {
        memory = '16 GB'
        cpus = 4
    }
    withName:digest_genome {
        memory = '8 GB'
        cpus = 1
    }
    withName:hic_align {
        memory = '28 GB'   // bwa-mem2 holds ~19 GB for a human/mouse index (bwa: ~7 GB); samtools sort ~3 GB
        cpus = 6
    }
    withName:hic_merge {
        memory = '96 GB'   // 8 chromosome merge | dedup | restrict pipelines at once; each restrict peaks at ~6.5 GB
                           // loading a 14.6M-fragment BED (mouse, DpnII+HinfI; np.genfromtxt, ~1:45 per load)
        cpus = 8
    }
    withName:hic_mcool {
        memory = '32 GB'
        cpus = 8
    }
}

profiles {
    // Small tests on one machine (tests/preprocess-hic).
    local {
        process.executor = 'local'
        process.errorStrategy = 'terminate'
        executor.cpus = 4
        process {
            withName:'split_fastq|digest_genome|hic_align|hic_merge|hic_mcool' {
                cpus = 2
                memory = null
            }
        }
    }
}

// Per-task resource trace, one file per launch in the launch dir (OUTDIR with the submit script).
trace {
    enabled = true
    file    = "${params.sample_id}.trace.${new Date().format('yyyyMMdd-HHmmss')}.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,submit,start,complete,duration,realtime,queue,cpus,memory,%cpu,%mem,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,syscr,syscw,vol_ctxt,inv_ctxt,workdir'
    raw     = true
}

// The submit script exports PREPROCESS_HIC_ENV (the release's conda env); its bin goes first on every task's PATH.
env {
    PATH = System.getenv('PREPROCESS_HIC_ENV') ? "${System.getenv('PREPROCESS_HIC_ENV')}/bin:${System.getenv('PATH')}" : System.getenv('PATH')
}
